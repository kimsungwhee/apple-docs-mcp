{
  "$schema": "https://raw.githubusercontent.com/grollat/carpool/main/schema/carpool.schema.json",
  "specVersion": "1",
  "isolation": "shared",
  "reason": "Tools fetch public Apple documentation; the in-memory cache only holds public data, which every session benefits from.",
  "partition": {
    "env": [
      "DEFAULT_ACCEPT_LANGUAGE",
      "DISABLE_DNT",
      "DISABLE_LANGUAGE_ROTATION",
      "DISABLE_SEC_FETCH",
      "SIMPLE_HEADERS_MODE",
      "MCP_DEBUG",
      "NODE_ENV"
    ],
    "cwd": false
  },
  "scaling": {
    "maxConcurrentRequests": 8,
    "maxInstances": 4
  }
}
